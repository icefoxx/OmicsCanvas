{
  "name": "omics-plot-plugins",
  "display_name": "Omics Plot Plugins",
  "version": "2.0.0",
  "description": "Agent-agnostic skill for creating, modifying, classifying, documenting and testing OmicsCanvas plot plugins under the rules in docs/standards.",
  "entrypoint": "SKILL.md",
  "references": [
    "references/plugin-guide.md"
  ],
  "runtime_contract": {
    "command": "Rscript plugins/<id>/plot.R --input input.csv --params params.json --output output_dir",
    "required_outputs": [
      "result.svg",
      "result.pdf",
      "result.png",
      "figure.json",
      "run.log"
    ],
    "error_output": "error.json"
  },
  "standards": [
    "docs/standards/README.md",
    "docs/standards/01_plugin_contract.md",
    "docs/standards/02_params_schema.md",
    "docs/standards/03_r_implementation.md",
    "docs/standards/04_classification.md",
    "docs/standards/05_examples_and_gallery.md",
    "docs/standards/06_quality_gates.md"
  ],
  "tools": {
    "scaffold": "scripts/new_plugin.py",
    "standards_check": "scripts/check_plugin_standards.py",
    "parameter_sensitivity": "scripts/param_sensitivity.py",
    "image_regression": "scripts/smoke_plugins.py",
    "gallery": "scripts/sync_gallery.py",
    "template": "templates/plugin/"
  }
}
