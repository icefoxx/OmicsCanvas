{
  "data": {
    "input_mode": {
      "type": "select",
      "label": "Input mode",
      "default": "auto",
      "options": ["auto", "wide", "long"],
      "help": "auto detects long format when stack_column + value_column exist."
    },
    "sample_column": {
      "type": "column",
      "label": "Sample / bar id column",
      "default": null,
      "help": "Defaults to the first column."
    },
    "group_column": {
      "type": "column",
      "label": "Group column",
      "default": null,
      "help": "Clusters bars and centers group labels on the categorical axis."
    },
    "value_columns": {
      "type": "columns",
      "label": "Stack value columns (wide)",
      "default": null,
      "help": "Numeric category columns to stack. Default: all numeric columns except sample/group."
    },
    "stack_column": {
      "type": "column",
      "label": "Category column (long)",
      "default": null
    },
    "value_column": {
      "type": "column",
      "label": "Value column (long)",
      "default": null
    },
    "samples_include": {
      "type": "string_array",
