{
  "plugin_id": "advanced_dim_plot",
  "examples": [
    {
      "id": "pdf_repro_basic_umap",
      "label": "Basic UMAP (clusters)",
      "mode": "group",
      "plot_type": "pdf_repro_basic_umap",
      "blurb": "Default group coloring + labels on HarmonyUMAP2D.",
      "howto": "plot_mode=group \u00b7 group_column=cluster \u00b7 label_groups=true",
      "card_group": "pdf_styles"
    },
    {
      "id": "pdf_repro_ellipse_mark",
      "label": "Ellipse marks",
      "mode": "group",
      "plot_type": "pdf_repro_ellipse_mark",
      "blurb": "Same UMAP with cluster ellipses (confidence hulls).",
      "howto": "show_mark=true \u00b7 mark_type=ellipse",
      "card_group": "pdf_styles"
    },
    {
      "id": "pdf_repro_split_samples",
      "label": "Split by sample",
      "mode": "group",
      "plot_type": "pdf_repro_split_samples",
      "blurb": "Facet panels by orig.ident (one UMAP per sample).",
      "howto": "split_column=orig.ident \u00b7 facet_split=true",
      "card_group": "pdf_styles"
    },
    {
      "id": "pdf_repro_composition_ring",
      "label": "Composition rings",
      "mode": "group",
      "plot_type": "pdf_repro_composition_ring",
      "blurb": "Embedded pie/ring showing sample composition per cluster.",
      "howto": "show_stat_embedded=true \u00b7 stat_plot_column=orig.ident",
      "card_group": "pdf_styles"
    },
    {
      "id": "pdf_repro_highlight_cells",
      "label": "Highlight cells",
      "mode": "group",
      "plot_type": "pdf_repro_highlight_cells",
      "blurb": "Focus a cell subset; others fade to grey.",
      "howto": "highlight_rows=[...] \u00b7 non_highlight_alpha < 1",
      "card_group": "pdf_styles"
    },
    {
      "id": "pdf_repro_bg_cutoff_mito",
      "label": "Background by mito cutoff",
      "mode": "group",
      "plot_type": "pdf_repro_bg_cutoff_mito",
      "blurb": "Push high-mito cells to background (cutoff=5%).",
      "howto": "background_column=mito \u00b7 background_cutoff=5",
      "card_group": "pdf_styles"
    },
    {
      "id": "pdf_repro_bg_condition",
