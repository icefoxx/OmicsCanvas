{
  "data": {
    "input_mode": {
      "type": "select",
      "options": [
        "edge_list",
        "membership"
      ],
      "default": "edge_list",
      "label": "Input Mode",
      "help": "edge_list uses source/target pairs. membership uses group/element (falls back to source/target) and is meant for radial layouts."
    },
    "source_column": {
      "type": "column",
      "label": "Source Column"
    },
    "target_column": {
      "type": "column",
      "label": "Target Column"
    },
    "node_id_column": {
      "type": "column",
      "label": "Node Id Column"
    },
    "group_column": {
      "type": "column",
      "label": "Group Column"
    },
    "weight_column": {
      "type": "column",
      "label": "Weight Column"
    },
    "edge_group_column": {
      "type": "column",
      "label": "Edge Group Column"
    },
    "directed": {
      "type": "boolean",
      "label": "Directed"
    },
    "nodes_include": {
      "type": "string_array",
      "label": "Nodes Include"
    },
    "nodes_exclude": {
      "type": "string_array",
      "label": "Nodes Exclude"
    },
    "group_order": {
      "type": "string_array",
      "label": "Group order",
      "default": [],
      "help": "Ring order for concentric, and group-node order for radial. Empty = data order."
    }
  },
  "layout": {
    "layout_algorithm": {
      "type": "select",
      "options": [
        "fr",
        "kk",
        "circle",
        "concentric",
        "radial",
        "stress",
        "hierarchical",
        "manual"
      ],
      "default": "fr",
      "label": "Layout algorithm",
      "help": "fr/kk/stress = force-directed; circle = one ring; concentric = one ring per group; radial = groups inside and members outside; hierarchical = tree; manual = x/y on the nodes table."
    },
    "layout_sort": {
      "type": "select",
      "options": ["none", "degree", "size", "label"],
      "default": "none",
      "label": "Ring sort",
      "help": "Order of nodes around a ring. Only for layout_algorithm = circle, concentric, or radial."
    },
    "ring_gap": {
      "type": "number",
      "label": "Ring gap",
      "default": 1,
      "min": 0.2,
      "max": 5,
      "step": 0.1,
      "help": "Radius step between rings. Only for layout_algorithm = concentric or radial."
    },
    "seed": {
      "type": "number",
      "label": "Seed",
      "default": 42,
      "help": "Runtime seed for random layouts (fr, kk, stress). No effect on circle, concentric, radial, or manual."
    }
  },
  "nodes": {
    "node_size": {
      "type": "number",
      "label": "Node Size",
      "default": 18,
      "help": "Constant node size. Only for node_size_by = constant."
    },
    "node_size_min": {
      "type": "number",
      "label": "Node Size Min"
    },
    "node_size_max": {
      "type": "number",
      "label": "Node Size Max"
    },
    "node_size_by": {
      "type": "select",
      "options": ["degree", "constant", "size_column"],
      "default": "degree",
      "label": "Node size by",
      "help": "degree scales by connectivity; constant uses node_size (or min/max for membership groups vs members); size_column uses a size field on the nodes table."
    },
    "node_color_mode": {
      "type": "select",
      "options": ["group", "gradient"],
      "default": "group",
      "label": "Node colour mode",
      "help": "group colours by the group column; gradient colours by degree (blue–white–red)."
    },
    "highlight_color": {
      "type": "color",
      "label": "Highlight colour",
      "default": "#D4A017",
      "help": "Ring colour for highlight_nodes / selected_nodes."
    },
    "node_alpha": {
      "type": "number",
      "label": "Node Alpha",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    "node_stroke": {
      "type": "number",
      "label": "Node Stroke"
    },
    "node_stroke_color": {
      "type": "color",
      "label": "Node Stroke Color"
    },
    "node_colors": {
      "type": "object",
      "label": "Node Colors"
    },
    "group_colors": {
      "type": "object",
      "label": "Group Colors"
    },
    "label_show": {
      "type": "boolean",
      "label": "Label Show",
      "default": true
    },
    "label_size": {
      "type": "number",
      "label": "Label Size"
    },
    "label_color": {
      "type": "color",
      "label": "Label Color"
    },
    "highlight_nodes": {
      "type": "string_array",
      "label": "Highlight Nodes"
    },
    "selected_nodes": {
      "type": "string_array",
      "label": "Selected Nodes"
    }
  },
  "edges": {
    "edge_color": {
      "type": "color",
      "label": "Edge Color"
    },
    "edge_width_min": {
      "type": "number",
      "label": "Edge Width Min"
    },
    "edge_width_max": {
      "type": "number",
      "label": "Edge Width Max"
    },
    "edge_alpha": {
      "type": "number",
      "label": "Edge Alpha"
    },
    "edge_weighted": {
      "type": "boolean",
      "label": "Weight edge width",
      "default": true,
      "help": "Map edge weight to line width. Off draws every edge at edge_width_min."
    },
    "edge_style": {
      "type": "select",
      "options": ["link", "arc"],
      "default": "link",
      "label": "Edge style",
      "help": "link = straight segments; arc = bowed chords (typical for circle layouts)."
    }
  },
  "legend": {
    "legend_show": {
      "type": "boolean",
      "label": "Legend Show",
      "default": true
    },
    "legend_position": {
      "type": "string",
      "label": "Legend Position"
    },
    "legend_text_size": {
      "type": "number",
      "label": "Legend Text Size"
    },
    "legend_title_size": {
      "type": "number",
      "label": "Legend Title Size"
    },
    "legend_key_size": {
      "type": "number",
      "label": "Legend Key Size"
    }
  },
  "canvas_theme": {
    "title": {
      "type": "string",
      "label": "Title"
    },
    "title_size": {
      "type": "number",
      "label": "Title Size"
    },
    "title_color": {
      "type": "color",
      "label": "Title Color"
    },
    "title_face": {
      "type": "select",
      "label": "Title Face",
      "options": [
        "plain",
        "bold",
        "italic",
        "bold.italic"
      ],
      "default": "plain"
    },
    "title_hjust": {
      "type": "number",
      "label": "Title Hjust"
    },
    "xlab": {
      "type": "string",
      "label": "Xlab"
    },
    "ylab": {
      "type": "string",
      "label": "Ylab"
    },
    "grid_show": {
      "type": "boolean",
      "label": "Grid Show"
    },
    "grid_color": {
      "type": "color",
      "label": "Grid Color"
    },
    "panel_background": {
      "type": "color",
      "label": "Panel Background"
    },
    "plot_background": {
      "type": "color",
      "label": "Plot Background"
    },
    "panel_border_show": {
      "type": "boolean",
      "label": "Panel Border Show"
    },
    "panel_border_color": {
      "type": "color",
      "label": "Panel Border Color"
    },
    "panel_border_width": {
      "type": "number",
      "label": "Panel Border Width"
    },
    "margin": {
      "type": "number",
      "label": "Margin"
    },
    "font_family": {
      "type": "string",
      "label": "Font Family"
    },
    "base_size": {
      "type": "number",
      "label": "Base Size"
    }
  },
  "interaction": {
    "interactive": {
      "type": "boolean",
      "label": "Interactive HTML",
      "default": true,
      "help": "Write a visNetwork HTML widget. Nodes keep the preset x/y and can be dragged when physics is off."
    },
    "drag_nodes": {
      "type": "boolean",
      "label": "Drag Nodes",
      "default": true,
      "help": "Allow dragging nodes in the HTML view to rearrange the preset layout."
    },
    "zoom_view": {
      "type": "boolean",
      "label": "Zoom View"
    },
    "highlight_neighborhood": {
      "type": "boolean",
      "label": "Highlight Neighborhood",
      "default": true,
      "help": "HTML only: highlight neighbours on click."
    },
    "navigation_buttons": {
      "type": "boolean",
      "label": "Navigation Buttons",
      "default": true,
      "help": "HTML only: zoom/pan buttons on the widget."
    },
    "selectable": {
      "type": "boolean",
      "label": "Selectable"
    },
    "tooltip_show": {
      "type": "boolean",
      "label": "Tooltip Show"
    },
    "physics_enabled": {
      "type": "boolean",
      "label": "Physics Enabled",
      "default": false,
      "help": "HTML only. Off keeps the preset x/y so nodes stay put after dragging. On lets vis.js simulate forces and ignores the preset."
    },
    "stabilize": {
      "type": "boolean",
      "label": "Stabilize",
      "default": true,
      "help": "HTML only: vis.js stabilization when physics is on."
    },
    "save_positions": {
      "type": "boolean",
      "label": "Save Positions",
      "default": false,
      "help": "Write positions.csv with the preset coordinates. Does not change the figure."
    }
  },
  "output": {
    "width": {
      "type": "number",
      "label": "Width"
    },
    "height": {
      "type": "number",
      "label": "Height"
    },
    "dpi": {
      "type": "number",
      "label": "Dpi"
    },
    "html_height": {
      "type": "number",
      "label": "Html Height"
    }
  }
}
