{
  "data_mapping": {
    "parent_column": {
      "type": "column",
      "default": "parent",
      "label": "Parent column",
      "help": ""
    },
    "child_column": {
      "type": "column",
      "default": "child",
      "label": "Child column",
      "help": ""
    },
    "length_column": {
      "type": "column",
      "default": "length",
      "label": "Length column",
      "help": ""
    },
    "group_column": {
      "type": "column",
      "default": "group",
      "label": "Group column",
      "help": ""
    },
    "size_column": {
      "type": "column",
      "default": "size",
      "label": "Size column",
      "help": ""
    },
    "feature_columns": {
      "type": "columns",
      "default": [],
      "label": "Feature columns",
      "help": "Numeric annotation features for the rectangular heatmap; empty = every non-node annotation column."
    }
  },
  "layout": {
    "layout": {
      "type": "select",
      "default": "rectangular",
      "label": "Layout",
      "help": "",
      "options": [
        "rectangular",
        "circular"
      ]
    },
    "gap_angle": {
      "type": "number",
      "default": 20,
      "label": "Gap angle",
      "help": "Circular layout only.",
      "min": 3,
      "max": 90
    },
    "heatmap_show": {
      "type": "boolean",
      "default": true,
      "label": "Heatmap show",
      "help": "Rectangular layout with an annotation table only."
    }
  },
  "labels": {
    "label_show": {
      "type": "boolean",
      "default": true,
      "label": "Label show",
      "help": ""
    },
    "label_size": {
      "type": "number",
      "default": 2.8,
      "label": "Label size",
      "help": "",
      "min": 1,
      "max": 6
    },
    "title": {
      "type": "string",
      "default": "",
      "label": "Title",
      "help": ""
    },
    "subtitle": {
      "type": "string",
      "default": "",
      "label": "Subtitle",
      "help": "Empty uses the automatic description."
    },
    "caption": {
      "type": "string",
      "default": "",
      "label": "Caption",
      "help": ""
    },
    "title_size": {
      "type": "number",
      "default": 13,
      "label": "Title size",
      "help": "Only when a nonempty title is supplied.",
      "min": 6,
      "max": 30
    }
  },
  "colors": {
    "tree_color": {
      "type": "color",
      "default": "#8CA1AE",
      "label": "Tree color",
      "help": ""
    },
    "palette": {
      "type": "select",
      "default": "Set 2",
      "label": "Palette",
      "help": "",
      "options": [
        "Set 2",
        "Dark 3",
        "Viridis"
      ]
    },
    "group_colors": {
      "type": "object",
      "default": {},
      "label": "Named colors",
      "help": "Named categorical colors override the palette."
    }
  },
  "marks": {
    "point_size": {
      "type": "number",
      "default": 2,
      "label": "Point size",
      "help": "",
      "min": 0.1,
      "max": 10
    },
    "line_width": {
      "type": "number",
      "default": 0.6,
      "label": "Line width",
      "help": "",
      "min": 0.1,
      "max": 3
    }
  },
  "legend": {
    "legend_show": {
      "type": "boolean",
      "default": true,
      "label": "Legend show",
      "help": ""
    },
    "legend_position": {
      "type": "select",
      "default": "right",
      "label": "Legend position",
      "help": "",
      "options": [
        "right",
        "bottom",
        "top",
        "left"
      ]
    },
    "legend_text_size": {
      "type": "number",
      "default": 9,
      "label": "Legend text size",
      "help": "",
      "min": 5,
      "max": 20
    }
  },
  "theme": {
    "font_family": {
      "type": "select",
      "default": "sans",
      "label": "Font family",
      "help": "",
      "options": [
        "sans",
        "serif",
        "mono"
      ]
    },
    "base_size": {
      "type": "number",
      "default": 11,
      "label": "Base size",
      "help": "",
      "min": 6,
      "max": 22
    },
    "plot_background": {
      "type": "color",
      "default": "#FFFFFF",
      "label": "Plot background",
      "help": ""
    }
  },
  "export": {
    "width": {
      "type": "number",
      "default": 8,
      "label": "Width",
      "help": "Inches.",
      "min": 3,
      "max": 20
    },
    "height": {
      "type": "number",
      "default": 6,
      "label": "Height",
      "help": "Inches.",
      "min": 3,
      "max": 20
    },
    "dpi": {
      "type": "integer",
      "default": 150,
      "label": "Dpi",
      "help": "",
      "min": 72,
      "max": 600
    }
  }
}
