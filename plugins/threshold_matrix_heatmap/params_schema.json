  "rules": {
    "default_rules": {
      "type": "textarea",
      "label": "Default cutoff rules",
      "help": "",
      "default": "<0.05=#C6FF1A|sig;else=#C9C9C9|non-sig"
    },
    "column_rules_string": {
      "type": "textarea",
      "label": "Per-column rules string",
