    {
      "id": "pdf_repro_basic_two_features",
      "label": "Basic \u00b7 Atoh1 + Neurod1",
      "blurb": "Two feature maps side by side (PDF basic).",
      "howto": "feature_columns=[Atoh1,Neurod1]",
      "card_group": "pdf_styles",
      "mode": "feature",
      "plot_type": "pdf_repro_basic_two_features"
    },
    {
      "id": "pdf_repro_multi_feature_scaled",
      "label": "Multi \u00b7 4 genes scaled",
      "blurb": "Neurod1/Atoh1/Alpl/Runx2 with per-feature scale + bg.cutoff=0.1.",
      "howto": "scale_by=feature \u00b7 quantile_cutoff=[0,0.95] \u00b7 background_cutoff=0.1",
      "card_group": "pdf_styles",
      "mode": "feature",
      "plot_type": "pdf_repro_multi_feature_scaled"
    },
