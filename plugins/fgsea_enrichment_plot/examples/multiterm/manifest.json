  "expected": "expected/result.png",
  "reproduce": {
    "command": "Rscript plugins/fgsea_enrichment_plot/plot.R --input plugins/fgsea_enrichment_plot/examples/multiterm/input/example_ranks.csv --params plugins/fgsea_enrichment_plot/examples/multiterm/params.json --output /tmp/fgsea_enrichment_plot_multiterm_out --genesets plugins/fgsea_enrichment_plot/examples/multiterm/input/example_pathways.gmt"
  }
}
