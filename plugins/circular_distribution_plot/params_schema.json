{
  "data_mapping": {
    "value_column": {
      "type": "column",
      "default": "score",
      "label": "Value column",
      "help": ""
    },
    "feature_column": {
      "type": "column",
      "default": "metric",
      "label": "Feature column",
      "help": ""
    },
    "group_column": {
      "type": "column",
      "default": "group",
      "label": "Group column",
      "help": ""
    },
    "id_column": {
      "type": "column",
      "default": "id",
      "label": "Id column",
      "help": ""
    }
  },
  "highlight": {
    "highlight_ids": {
      "type": "string_array",
      "default": [],
      "label": "Highlight ids",
      "help": ""
    },
    "highlight_color": {
      "type": "color",
      "default": "#D74855",
      "label": "Highlight color",
      "help": "Only when highlight_ids matches input observations."
    }
  },
  "layout": {
    "gap_angle": {
      "type": "number",
      "default": 60,
      "label": "Gap angle",
      "help": "",
      "min": 10,
      "max": 150
    },
    "range_mode": {
      "type": "select",
      "default": "free",
      "label": "Range mode",
      "help": "",
      "options": [
        "free",
        "shared"
      ]
    },
    "ncol": {
      "type": "integer",
      "default": 3,
      "label": "Ncol",
      "help": "Maximum panels per row. Values at or above the number of metrics produce the same single-row layout.",
      "min": 1,
      "max": 6
    }
  },
  "marks": {
    "point_alpha": {
      "type": "number",
      "default": 0.6,
      "label": "Point alpha",
      "help": "",
      "min": 0.05,
      "max": 1
    },
    "point_size": {
      "type": "number",
      "default": 2,
      "label": "Point size",
      "help": "",
      "min": 0.1,
      "max": 10
    },
    "line_width": {
      "type": "number",
      "default": 0.6,
      "label": "Line width",
      "help": "",
      "min": 0.1,
      "max": 3
    }
  },
  "labels": {
    "label_size": {
      "type": "number",
      "default": 2.8,
      "label": "Label size",
      "help": "",
      "min": 1,
      "max": 6
    },
    "title": {
      "type": "string",
      "default": "",
      "label": "Title",
      "help": ""
    },
    "subtitle": {
      "type": "string",
      "default": "",
      "label": "Subtitle",
      "help": "Empty uses the automatic description."
    },
    "caption": {
      "type": "string",
      "default": "",
      "label": "Caption",
      "help": ""
    },
    "title_size": {
      "type": "number",
      "default": 13,
      "label": "Title size",
      "help": "Only when a nonempty title is supplied.",
      "min": 6,
      "max": 30
    }
  },
  "colors": {
    "palette": {
      "type": "select",
      "default": "Set 2",
      "label": "Palette",
      "help": "",
      "options": [
        "Set 2",
        "Dark 3",
        "Viridis"
      ]
    },
    "group_colors": {
      "type": "object",
      "default": {},
      "label": "Named colors",
      "help": "Named categorical colors override the palette."
    }
  },
  "legend": {
    "legend_show": {
      "type": "boolean",
      "default": true,
      "label": "Legend show",
      "help": ""
    },
    "legend_position": {
      "type": "select",
      "default": "right",
      "label": "Legend position",
      "help": "",
      "options": [
        "right",
        "bottom",
        "top",
        "left"
      ]
    },
    "legend_text_size": {
      "type": "number",
      "default": 9,
      "label": "Legend text size",
      "help": "",
      "min": 5,
      "max": 20
    }
  },
  "theme": {
    "font_family": {
      "type": "select",
      "default": "sans",
      "label": "Font family",
      "help": "",
      "options": [
        "sans",
        "serif",
        "mono"
      ]
    },
    "base_size": {
      "type": "number",
      "default": 11,
      "label": "Base size",
      "help": "",
      "min": 6,
      "max": 22
    },
    "plot_background": {
      "type": "color",
      "default": "#FFFFFF",
      "label": "Plot background",
      "help": ""
    }
  },
  "export": {
    "width": {
      "type": "number",
      "default": 8,
      "label": "Width",
      "help": "Inches.",
      "min": 3,
      "max": 20
    },
    "height": {
      "type": "number",
      "default": 6,
      "label": "Height",
      "help": "Inches.",
      "min": 3,
      "max": 20
    },
    "dpi": {
      "type": "integer",
      "default": 150,
      "label": "Dpi",
      "help": "",
      "min": 72,
      "max": 600
    }
  }
}
