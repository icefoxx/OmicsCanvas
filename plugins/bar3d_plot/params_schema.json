{
  "data_mapping": {
    "x_column": {
      "type": "column",
      "default": "x",
      "label": "X column",
      "help": ""
    },
    "y_column": {
      "type": "column",
      "default": "y",
      "label": "Y column",
      "help": ""
    },
    "value_column": {
      "type": "column",
      "default": "count",
      "label": "Value column",
      "help": ""
    },
    "group_column": {
      "type": "column",
      "default": "group",
      "label": "Group column",
      "help": ""
    }
  },
  "layout": {
    "azimuth": {
      "type": "number",
      "default": 40,
      "label": "Azimuth",
      "help": "",
      "min": 10,
      "max": 80
    },
    "elevation": {
      "type": "number",
      "default": 25,
      "label": "Elevation",
      "help": "",
      "min": 10,
      "max": 70
    },
    "z_scale": {
      "type": "select",
      "default": "shared",
      "label": "Z scale",
      "help": "",
      "options": [
        "shared",
        "free"
      ]
    },
    "ncol": {
      "type": "integer",
      "default": 3,
      "label": "Ncol",
      "help": "",
      "min": 1,
      "max": 6
    }
  },
  "marks": {
    "bar_width": {
      "type": "number",
      "default": 0.72,
      "label": "Bar width",
      "help": "",
      "min": 0.2,
      "max": 0.95
    },
    "line_width": {
      "type": "number",
      "default": 0.6,
      "label": "Line width",
      "help": "",
      "min": 0.1,
      "max": 3
    }
  },
  "labels": {
    "label_size": {
      "type": "number",
      "default": 2.8,
      "label": "Label size",
      "help": "",
      "min": 1,
      "max": 6
    },
    "title": {
      "type": "string",
      "default": "",
      "label": "Title",
      "help": ""
    },
    "subtitle": {
      "type": "string",
      "default": "",
      "label": "Subtitle",
      "help": "Empty uses the automatic description."
    },
    "caption": {
      "type": "string",
      "default": "",
      "label": "Caption",
      "help": ""
    },
    "title_size": {
      "type": "number",
      "default": 13,
      "label": "Title size",
      "help": "Only when a nonempty title is supplied.",
      "min": 6,
      "max": 30
    }
  },
  "colors": {
    "palette": {
      "type": "select",
      "default": "Set 2",
      "label": "Palette",
      "help": "",
      "options": [
        "Set 2",
        "Dark 3",
        "Viridis"
      ]
    },
    "group_colors": {
      "type": "object",
      "default": {},
      "label": "Named colors",
      "help": "Named categorical colors override the palette."
    }
  },
  "theme": {
    "font_family": {
      "type": "select",
      "default": "sans",
      "label": "Font family",
      "help": "",
      "options": [
        "sans",
        "serif",
        "mono"
      ]
    },
    "base_size": {
      "type": "number",
      "default": 11,
      "label": "Base size",
      "help": "",
      "min": 6,
      "max": 22
    },
    "plot_background": {
      "type": "color",
      "default": "#FFFFFF",
      "label": "Plot background",
      "help": ""
    }
  },
  "export": {
    "width": {
      "type": "number",
      "default": 8,
      "label": "Width",
      "help": "Inches.",
      "min": 3,
      "max": 20
    },
    "height": {
      "type": "number",
      "default": 6,
      "label": "Height",
      "help": "Inches.",
      "min": 3,
      "max": 20
    },
    "dpi": {
      "type": "integer",
      "default": 150,
      "label": "Dpi",
      "help": "",
      "min": 72,
      "max": 600
    }
  }
}
