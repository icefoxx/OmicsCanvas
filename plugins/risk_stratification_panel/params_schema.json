{
  "data_mapping": {
    "id_column": {
      "type": "column",
      "default": "subject",
      "label": "Id column",
      "help": ""
    },
    "value_column": {
      "type": "column",
      "default": "risk_score",
      "label": "Value column",
      "help": ""
    },
    "time_column": {
      "type": "column",
      "default": "time",
      "label": "Time column",
      "help": ""
    },
    "event_column": {
      "type": "column",
      "default": "event",
      "label": "Event column",
      "help": ""
    },
    "group_column": {
      "type": "column",
      "default": "group",
      "label": "Group column",
      "help": ""
    },
    "feature_columns": {
      "type": "columns",
      "default": [],
      "label": "Feature columns",
      "help": ""
    }
  },
  "layout": {
    "sort_by": {
      "type": "select",
      "default": "risk",
      "label": "Sort by",
      "help": "",
      "options": [
        "risk",
        "input"
      ]
    },
    "heatmap_show": {
      "type": "boolean",
      "default": true,
      "label": "Heatmap show",
      "help": "Only when feature_columns are selected."
    }
  },
  "statistics": {
    "scale_features": {
      "type": "boolean",
      "default": true,
      "label": "Scale features",
      "help": "Only for selected features in the visible heatmap."
    }
  },
  "labels": {
    "subject_label_show": {
      "type": "boolean",
      "default": false,
      "label": "Subject label show",
      "help": ""
    },
    "title": {
      "type": "string",
      "default": "",
      "label": "Title",
      "help": ""
    },
    "subtitle": {
      "type": "string",
      "default": "",
      "label": "Subtitle",
      "help": "Empty uses the automatic description."
    },
    "caption": {
      "type": "string",
      "default": "",
      "label": "Caption",
      "help": ""
    },
    "title_size": {
      "type": "number",
      "default": 13,
      "label": "Title size",
      "help": "Only when a nonempty title is supplied.",
      "min": 6,
      "max": 30
    }
  },
  "marks": {
    "point_alpha": {
      "type": "number",
      "default": 0.8,
      "label": "Point alpha",
      "help": "",
      "min": 0.05,
      "max": 1
    },
    "point_size": {
      "type": "number",
      "default": 2,
      "label": "Point size",
      "help": "",
      "min": 0.1,
      "max": 10
    }
  },
  "colors": {
    "low_color": {
      "type": "color",
      "default": "#397DA3",
      "label": "Low color",
      "help": "Selected-feature heatmap only."
    },
    "high_color": {
      "type": "color",
      "default": "#D16472",
      "label": "High color",
      "help": "Selected-feature heatmap only."
    },
    "palette": {
      "type": "select",
      "default": "Set 2",
      "label": "Palette",
      "help": "",
      "options": [
        "Set 2",
        "Dark 3",
        "Viridis"
      ]
    },
    "group_colors": {
      "type": "object",
      "default": {},
      "label": "Named colors",
      "help": "Named categorical colors override the palette."
    }
  },
  "legend": {
    "legend_show": {
      "type": "boolean",
      "default": true,
      "label": "Legend show",
      "help": ""
    },
    "legend_position": {
      "type": "select",
      "default": "right",
      "label": "Legend position",
      "help": "",
      "options": [
        "right",
        "bottom",
        "top",
        "left"
      ]
    },
    "legend_text_size": {
      "type": "number",
      "default": 9,
      "label": "Legend text size",
      "help": "",
      "min": 5,
      "max": 20
    }
  },
  "theme": {
    "font_family": {
      "type": "select",
      "default": "sans",
      "label": "Font family",
      "help": "",
      "options": [
        "sans",
        "serif",
        "mono"
      ]
    },
    "base_size": {
      "type": "number",
      "default": 11,
      "label": "Base size",
      "help": "",
      "min": 6,
      "max": 22
    },
    "plot_background": {
      "type": "color",
      "default": "#FFFFFF",
      "label": "Plot background",
      "help": ""
    },
    "grid_show": {
      "type": "boolean",
      "default": false,
      "label": "Grid show",
      "help": ""
    }
  },
  "export": {
    "width": {
      "type": "number",
      "default": 8,
      "label": "Width",
      "help": "Inches.",
      "min": 3,
      "max": 20
    },
    "height": {
      "type": "number",
      "default": 6,
      "label": "Height",
      "help": "Inches.",
      "min": 3,
      "max": 20
    },
    "dpi": {
      "type": "integer",
      "default": 150,
      "label": "Dpi",
      "help": "",
      "min": 72,
      "max": 600
    }
  }
}
