        "command": "Rscript plugins/dot_plot/plot.R --input plugins/dot_plot/examples/aggregate/input/example_matrix.csv --params plugins/dot_plot/examples/aggregate/params.json --output /tmp/dot_plot_aggregate_out --annot plugins/dot_plot/examples/aggregate/input/example_annotation.csv"
      },
