{
  "data_mapping": {
    "group_column": {
      "type": "column",
      "default": "clone",
      "label": "Group column",
      "help": ""
    },
    "parent_column": {
      "type": "column",
      "default": "parent",
      "label": "Parent column",
      "help": ""
    },
    "x_column": {
      "type": "column",
      "default": "time",
      "label": "X column",
      "help": ""
    },
    "value_column": {
      "type": "column",
      "default": "fraction",
      "label": "Value column",
      "help": ""
    },
    "fraction_unit": {
      "type": "select",
      "default": "fraction",
      "label": "Fraction unit",
      "help": "",
      "options": [
        "fraction",
        "percent"
      ]
    }
  },
  "marks": {
    "timepoint_show": {
      "type": "boolean",
      "default": true,
      "label": "Timepoint show",
      "help": ""
    },
    "fill_alpha": {
      "type": "number",
      "default": 0.9,
      "label": "Fill alpha",
      "help": "",
      "min": 0.1,
      "max": 1
    },
    "line_width": {
      "type": "number",
      "default": 0.6,
      "label": "Line width",
      "help": "",
      "min": 0.1,
      "max": 3
    }
  },
  "colors": {
    "palette": {
      "type": "select",
      "default": "Set 2",
      "label": "Palette",
      "help": "",
      "options": [
        "Set 2",
        "Dark 3",
        "Viridis"
      ]
    },
    "group_colors": {
      "type": "object",
      "default": {},
      "label": "Named colors",
      "help": "Named categorical colors override the palette."
    }
  },
  "labels": {
    "title": {
      "type": "string",
      "default": "",
      "label": "Title",
      "help": ""
    },
    "subtitle": {
      "type": "string",
      "default": "",
      "label": "Subtitle",
      "help": "Empty uses the automatic description."
    },
    "caption": {
      "type": "string",
      "default": "",
      "label": "Caption",
      "help": ""
    },
    "title_size": {
      "type": "number",
      "default": 13,
      "label": "Title size",
      "help": "Only when a nonempty title is supplied.",
      "min": 6,
      "max": 30
    }
  },
  "legend": {
    "legend_show": {
      "type": "boolean",
      "default": true,
      "label": "Legend show",
      "help": ""
    },
    "legend_position": {
      "type": "select",
      "default": "right",
      "label": "Legend position",
      "help": "",
      "options": [
        "right",
        "bottom",
        "top",
        "left"
      ]
    },
    "legend_text_size": {
      "type": "number",
      "default": 9,
      "label": "Legend text size",
      "help": "",
      "min": 5,
      "max": 20
    }
  },
  "theme": {
    "font_family": {
      "type": "select",
      "default": "sans",
      "label": "Font family",
      "help": "",
      "options": [
        "sans",
        "serif",
        "mono"
      ]
    },
    "base_size": {
      "type": "number",
      "default": 11,
      "label": "Base size",
      "help": "",
      "min": 6,
      "max": 22
    },
    "plot_background": {
      "type": "color",
      "default": "#FFFFFF",
      "label": "Plot background",
      "help": ""
    },
    "grid_show": {
      "type": "boolean",
      "default": false,
      "label": "Grid show",
      "help": ""
    }
  },
  "export": {
    "width": {
      "type": "number",
      "default": 8,
      "label": "Width",
      "help": "Inches.",
      "min": 3,
      "max": 20
    },
    "height": {
      "type": "number",
      "default": 6,
      "label": "Height",
      "help": "Inches.",
      "min": 3,
      "max": 20
    },
    "dpi": {
      "type": "integer",
      "default": 150,
      "label": "Dpi",
      "help": "",
      "min": 72,
      "max": 600
    }
  }
}
