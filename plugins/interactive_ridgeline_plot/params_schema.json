    "axes": ["xlab", "ylab", "title", "subtitle", "caption", "title_show", "title_size", "title_color", "title_face", "title_hjust", "subtitle_size", "subtitle_color", "subtitle_face", "x_axis_show", "x_axis_text_size", "x_axis_text_color", "x_axis_text_angle", "y_axis_show", "y_axis_text_size", "y_axis_text_color", "y_axis_text_angle", "axis_line_show", "axis_line_color", "axis_line_width", "tick_show", "tick_color", "tick_width", "grid_show", "grid_color", "grid_width", "grid_linetype", "panel_border_show", "panel_border_color", "panel_border_width"],
    "labels/highlights": ["feature_label_show", "feature_label_size", "feature_label_color", "feature_label_face", "feature_label_family", "feature_label_angle", "feature_label_offset", "value_label_show", "value_label_size", "value_label_color", "highlight_features", "highlight_color", "highlight_alpha", "highlight_points"],
    "legend/theme": ["legend_show", "legend_position", "legend_title", "legend_text_size", "legend_title_size", "legend_key_size", "legend_ncol", "palette", "font_family", "base_size", "panel_background", "plot_background"],
    "interaction": ["interactive", "tooltip_columns", "hover_template", "selectable", "lasso_select", "zoom", "pan", "reset_view"],
