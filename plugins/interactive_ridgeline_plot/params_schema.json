  "properties": {
    "input_mode": {"type": "string", "enum": ["auto", "wide", "long"], "default": "auto"},
    "cloud_stat": {"type": "string", "enum": ["density", "count"], "default": "density"},
    "cloud_fill_mode": {"type": "string", "enum": ["feature", "group"], "default": "feature"},
    "fill_mode": {"type": "string", "enum": ["feature", "group"], "default": "feature"},
    "group_overlay": {"type": "boolean", "default": true},
    "group_order": {"type": "array"}, "group_colors": {"type": ["array", "object"]}, "group_alpha": {"type": "number", "default": 0.75},
    "group_outline_show": {"type": "boolean", "default": false}, "group_outline_color": {"type": "string", "default": "#333333"}, "group_outline_width": {"type": "number", "default": 0.4}, "group_legend_show": {"type": "boolean", "default": true}, "group_legend_title": {"type": "string", "default": "Group"}, "group_legend_position": {"type": "string", "default": "right"},
    "baseline_show": {"type": "boolean", "default": true}, "baseline_color": {"type": "string", "default": "#777777"}, "baseline_width": {"type": "number", "default": 0.35}, "baseline_linetype": {"type": "string", "default": "solid"},
    "show_group_baseline": {"type": "boolean", "default": false},
    "statistic_show": {"type": "boolean", "default": false}, "statistic_method": {"type": "string", "enum": ["none", "cohen_d", "t_test", "wilcoxon", "supplied"], "default": "none"}, "statistic_columns": {"type": ["array", "object"], "default": ["d", "p"]}, "statistic_labels": {"type": ["array", "object"]}, "statistic_position": {"type": "string", "enum": ["right", "left", "inside"], "default": "right"}, "statistic_size": {"type": "number", "default": 3.5}, "statistic_color": {"type": "string", "default": "#333333"}, "statistic_digits": {"type": "integer", "default": 3}, "statistic_x": {"type": "number"}, "statistic_y_offset": {"type": "number", "default": 0},
    "point_position": {"type": "string", "enum": ["below", "baseline", "on_baseline"], "default": "below"},
    "interactive": {"type": "boolean", "default": true},
    "shared_x_scale": {"type": "boolean", "default": true},
    "width": {"type": "number", "default": 10}, "height": {"type": "number", "default": 6},
    "dpi": {"type": "integer", "default": 300},
    "export_formats": {"type": "array", "default": ["svg", "pdf", "png", "html"]},
    "x_limits": {"type": "array"}, "x_breaks": {"type": "array"},
    "feature_order": {"type": "array"}, "features_include": {"type": "array"}, "features_exclude": {"type": "array"},
    "cloud_colors": {"type": ["array", "object"]}, "point_colors": {"type": ["array", "object"]}
  }
}
