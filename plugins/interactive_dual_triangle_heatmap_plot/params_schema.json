{
  "data": {
    "allow_reorder": {
      "type": "boolean",
      "default": false
    },
    "lower_input": {
      "type": "string"
    },
    "features_include": {
      "type": "array"
    },
    "features_exclude": {
      "type": "array"
    },
    "feature_order": {
      "type": "array"
    }
  },
  "metrics": {
    "upper_label": {
      "type": "string",
      "default": "Jaccard similarity"
    },
    "lower_label": {
      "type": "string",
      "default": "Pearson correlation"
    },
    "upper_metric": {
      "type": "string",
      "default": "jaccard"
    },
    "lower_metric": {
      "type": "string",
      "default": "pearson"
    },
    "upper_dataset": {
      "type": "string"
    },
    "lower_dataset": {
      "type": "string"
    }
  },
  "scales": {
    "upper_palette": {
      "type": "string",
      "default": "red"
    },
    "lower_palette": {
      "type": "string",
      "default": "blue"
    },
    "upper_colors": {
      "type": "array"
    },
    "lower_colors": {
      "type": "array"
    },
    "upper_limits": {
      "type": "array"
    },
    "lower_limits": {
      "type": "array"
    },
    "upper_breaks": {
      "type": "array"
    },
    "lower_breaks": {
      "type": "array"
    },
    "upper_colorbar_show": {
      "type": "boolean",
      "default": true
    },
    "lower_colorbar_show": {
      "type": "boolean",
      "default": true
    },
    "upper_colorbar_title": {
      "type": "string"
    },
    "lower_colorbar_title": {
      "type": "string"
    },
    "legend_position": {
      "type": "string"
    }
  },
  "triangles": {
    "upper_triangle_show": {
      "type": "boolean",
      "default": true
    },
    "lower_triangle_show": {
      "type": "boolean",
      "default": true
    },
    "diagonal_mode": {
      "type": "string",
      "enum": [
        "none",
        "upper",
        "lower",
        "average",
        "label"
      ],
      "default": "none"
    },
    "diagonal_color": {
      "type": "color",
      "default": "#DDDDDD"
    },
    "cell_border_show": {
      "type": "boolean",
      "default": true
    },
    "cell_border_color": {
      "type": "color",
      "default": "#FFFFFF"
    },
    "cell_border_width": {
      "type": "number",
      "default": 0.2
    },
    "show_values": {
      "type": "boolean",
      "default": false
    },
    "value_color": {
      "type": "color",
      "default": "#222222"
    },
    "value_size": {
      "type": "number",
      "default": 7
    }
  },
  "clustering": {
    "cluster_features": {
      "type": "boolean",
      "default": false
    },
    "cluster_method": {
      "type": "string",
      "default": "complete"
    },
    "distance_method": {
      "type": "string",
      "default": "euclidean"
    },
    "cluster_source": {
      "type": "string",
      "enum": [
        "upper",
        "lower",
        "mean"
      ],
      "default": "mean"
    },
    "reverse_order": {
      "type": "boolean",
      "default": false
    }
  },
  "annotations": {
    "annotation_file": {
      "type": "string"
    },
    "annotation_columns": {
      "type": "columns"
    },
    "dataset_annotation_show": {
      "type": "boolean",
      "default": false
    },
    "annotation_colors": {
      "type": "object"
    },
    "annotation_strip_show": {
      "type": "boolean",
      "default": false
    },
    "annotation_strip_height": {
      "type": "number",
      "default": 0.035
    },
    "annotation_label_show": {
      "type": "boolean",
      "default": false
    },
    "annotation_label_size": {
      "type": "number",
      "default": 8
    }
  },
  "labels_theme": {
    "xlab": {
      "type": "string"
    },
    "ylab": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "title_size": {
      "type": "number"
    },
    "title_color": {
      "type": "color"
    },
    "title_face": {
      "type": "select",
      "options": [
        "plain",
        "bold",
        "italic",
        "bold.italic"
      ],
      "default": "plain"
    },
    "x_text_show": {
      "type": "boolean",
      "default": true
    },
    "y_text_show": {
      "type": "boolean",
      "default": true
    },
    "x_text_size": {
      "type": "number"
    },
    "y_text_size": {
      "type": "number"
    },
    "x_text_color": {
      "type": "color"
    },
    "x_text_angle": {
      "type": "number",
      "default": 45
    },
    "font_family": {
      "type": "string",
      "default": "sans"
    },
    "plot_background": {
      "type": "color",
      "default": "#FFFFFF"
    },
    "legend_position": {
      "type": "string"
    },
    "width": {
      "type": "number",
      "default": 11
    },
    "height": {
      "type": "number",
      "default": 10
    },
    "dpi": {
      "type": "integer",
      "default": 300
    }
  },
  "interaction": {
    "interactive": {
      "type": "boolean",
      "default": true
    },
    "pan": {
      "type": "boolean",
      "default": true
    },
    "selectable": {
      "type": "boolean",
      "default": false
    },
    "lasso": {
      "type": "boolean",
      "default": false
    }
  }
}
