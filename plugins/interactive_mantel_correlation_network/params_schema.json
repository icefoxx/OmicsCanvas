{
  "groups": {
    "data": [
      "input_mode",
      "correlation_method",
      "env_id_column",
      "spec_id_column",
      "env_include",
      "env_exclude",
      "feature_order",
      "community_groups",
      "community_name",
      "community_order",
      "spec_distance",
      "mantel_permutations",
      "env_column",
      "spec_column",
      "r_column",
      "pvalue_column"
    ],
    "matrix": [
      "cell_border_show",
      "cell_border_color"
    ],
    "colors": [
      "neg_color",
      "pos_color",
      "mid_color"
    ],
    "mantel_links": [
      "link_show",
      "p_bins",
      "p_colors",
      "link_alpha",
      "link_curvature"
    ],
    "labels": [
      "title",
      "title_show",
      "title_size",
      "title_color",
      "title_face",
      "diag_label_size",
      "spec_label_size",
      "spec_point_size"
    ],
    "legend": [
      "legend_show",
      "legend_position",
      "legend_title_size",
      "legend_text_size"
    ],
    "export": [
      "width",
      "height",
      "dpi",
      "interactive"
    ]
  },
  "properties": {
    "input_mode": {
      "type": "string",
      "enum": [
        "auto",
        "precomputed",
        "compute"
      ],
      "default": "auto",
      "label": "Input mode"
    },
    "correlation_method": {
      "type": "string",
      "enum": [
        "pearson",
        "spearman",
        "kendall"
      ],
      "default": "pearson",
      "label": "Env correlation method"
    },
    "env_id_column": {
      "type": "column",
      "default": null,
      "label": "Sample id column (env table)"
    },
    "spec_id_column": {
      "type": "column",
      "default": null,
      "label": "Sample id column (community table)"
    },
    "env_include": {
      "type": "array",
      "default": [],
      "label": "Environmental variables to include"
    },
    "env_exclude": {
      "type": "array",
      "default": [],
      "label": "Environmental variables to exclude"
    },
    "feature_order": {
      "type": "array",
      "default": [],
      "label": "Environmental variable order"
    },
    "community_groups": {
      "type": "object",
      "default": {},
      "label": "Map of community name → taxon columns"
    },
    "community_name": {
      "type": "string",
      "default": "Community",
      "label": "Name when using all community columns as one matrix"
    },
    "community_order": {
      "type": "array",
      "default": [],
      "label": "Community / Mantel node order"
    },
    "spec_distance": {
      "type": "string",
      "default": "bray",
      "label": "Community distance (vegan vegdist)"
    },
    "mantel_permutations": {
      "type": "integer",
      "default": 9999,
      "label": "Mantel permutations"
    },
    "p_adjust": {
      "type": "string",
      "enum": [
        "none",
        "BH",
        "bonferroni"
      ],
      "default": "BH",
      "label": "Multiple-testing correction for Mantel P"
    },
    "random_state": {
      "type": "integer",
      "default": 123,
      "label": "Random seed"
    },
    "show_top_labels": {
      "type": "boolean",
      "default": true,
      "label": "Show rotated env names above the matrix"
    },
    "r_bins": {
      "type": "array",
      "default": [
        0.25,
        0.5
      ],
      "label": "Mantel r width cut points"
    },
    "r_widths": {
      "type": "array",
      "default": [
        0.7,
        2.0,
        4.6
      ],
      "label": "Line widths for r bins"
    },
    "neg_color": {
      "type": "color",
      "default": "#B2182B",
      "label": "Color for negative Pearson r"
    },
    "pos_color": {
      "type": "color",
      "default": "#2166AC",
      "label": "Color for positive Pearson r"
    },
    "mid_color": {
      "type": "color",
      "default": "#F7F7F7",
      "label": "Color for Pearson r near 0"
    },
    "p_bins": {
      "type": "array",
      "default": [
        0.001,
        0.01,
        0.05
      ],
      "label": "Mantel p/FDR cut points"
    },
    "p_colors": {
      "type": "array",
      "default": [
        "#E69F00",
        "#009E73",
        "#6A3D9A",
        "#D0D0D0"
      ],
      "label": "Colors for p < 0.001, < 0.01, < 0.05, ns"
    },
    "link_show": {
      "type": "boolean",
      "default": true
    },
    "link_alpha": {
      "type": "number",
      "default": 0.92
    },
    "link_curvature": {
      "type": "number",
      "default": 0.25
    },
    "title": {
      "type": "string",
      "default": "Mantel + Pearson correlation"
    },
    "title_show": {
      "type": "boolean",
      "default": true
    },
    "legend_show": {
      "type": "boolean",
      "default": true
    },
    "legend_position": {
      "type": "string",
      "default": "right"
    },
    "interactive": {
      "type": "boolean",
      "default": false
    },
    "width": {
      "type": "number",
      "default": 9.2
    },
    "height": {
      "type": "number",
      "default": 7.2
    },
    "dpi": {
      "type": "number",
      "default": 300
    }
  }
}
