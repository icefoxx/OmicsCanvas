{
  "data_mapping": {
    "pvalue_column": {
      "type": "column",
      "default": "pvalue",
      "label": "Pvalue column",
      "help": ""
    },
    "chromosome_column": {
      "type": "column",
      "default": "chromosome",
      "label": "Chromosome column",
      "help": ""
    },
    "position_column": {
      "type": "column",
      "default": "position",
      "label": "Position column",
      "help": ""
    },
    "label_column": {
      "type": "column",
      "default": "label",
      "label": "Label column",
      "help": ""
    }
  },
  "layout": {
    "plot_type": {
      "type": "select",
      "default": "both",
      "label": "Plot type",
      "help": "",
      "options": [
        "both",
        "manhattan",
        "qq"
      ]
    }
  },
  "statistics": {
    "pvalue_threshold": {
      "type": "number",
      "default": 5e-08,
      "label": "Pvalue threshold",
      "help": "Raw probability; applies to Manhattan panel only.",
      "min": 1e-12,
      "max": 0.1
    }
  },
  "colors": {
    "threshold_color": {
      "type": "color",
      "default": "#D36161",
      "label": "Threshold color",
      "help": "Only for Manhattan panel."
    },
    "qq_color": {
      "type": "color",
      "default": "#466F90",
      "label": "Qq color",
      "help": "Only for QQ panel."
    },
    "palette": {
      "type": "select",
      "default": "Set 2",
      "label": "Palette",
      "help": "",
      "options": [
        "Set 2",
        "Dark 3",
        "Viridis"
      ]
    },
    "group_colors": {
      "type": "object",
      "default": {},
      "label": "Named colors",
      "help": "Named categorical colors override the palette."
    }
  },
  "labels": {
    "label_show": {
      "type": "boolean",
      "default": true,
      "label": "Label show",
      "help": ""
    },
    "label_size": {
      "type": "number",
      "default": 2.8,
      "label": "Label size",
      "help": "",
      "min": 1,
      "max": 6
    },
    "title": {
      "type": "string",
      "default": "",
      "label": "Title",
      "help": ""
    },
    "subtitle": {
      "type": "string",
      "default": "",
      "label": "Subtitle",
      "help": "Empty uses the automatic description."
    },
    "caption": {
      "type": "string",
      "default": "",
      "label": "Caption",
      "help": ""
    },
    "title_size": {
      "type": "number",
      "default": 13,
      "label": "Title size",
      "help": "Only when a nonempty title is supplied.",
      "min": 6,
      "max": 30
    }
  },
  "marks": {
    "point_alpha": {
      "type": "number",
      "default": 0.75,
      "label": "Point alpha",
      "help": "",
      "min": 0.05,
      "max": 1
    },
    "point_size": {
      "type": "number",
      "default": 2,
      "label": "Point size",
      "help": "",
      "min": 0.1,
      "max": 10
    },
    "line_width": {
      "type": "number",
      "default": 0.6,
      "label": "Line width",
      "help": "",
      "min": 0.1,
      "max": 3
    }
  },
  "theme": {
    "font_family": {
      "type": "select",
      "default": "sans",
      "label": "Font family",
      "help": "",
      "options": [
        "sans",
        "serif",
        "mono"
      ]
    },
    "base_size": {
      "type": "number",
      "default": 11,
      "label": "Base size",
      "help": "",
      "min": 6,
      "max": 22
    },
    "plot_background": {
      "type": "color",
      "default": "#FFFFFF",
      "label": "Plot background",
      "help": ""
    },
    "grid_show": {
      "type": "boolean",
      "default": false,
      "label": "Grid show",
      "help": ""
    }
  },
  "export": {
    "width": {
      "type": "number",
      "default": 8,
      "label": "Width",
      "help": "Inches.",
      "min": 3,
      "max": 20
    },
    "height": {
      "type": "number",
      "default": 6,
      "label": "Height",
      "help": "Inches.",
      "min": 3,
      "max": 20
    },
    "dpi": {
      "type": "integer",
      "default": 150,
      "label": "Dpi",
      "help": "",
      "min": 72,
      "max": 600
    }
  }
}
