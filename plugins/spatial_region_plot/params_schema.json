{
  "data_mapping": {
    "x_column": {
      "type": "column",
      "default": "x",
      "label": "X column",
      "help": ""
    },
    "y_column": {
      "type": "column",
      "default": "y",
      "label": "Y column",
      "help": ""
    },
    "group_column": {
      "type": "column",
      "default": "region",
      "label": "Group column",
      "help": ""
    },
    "value_column": {
      "type": "column",
      "default": "value",
      "label": "Value column",
      "help": ""
    },
    "part_column": {
      "type": "column",
      "default": "part",
      "label": "Part column",
      "help": ""
    }
  },
  "axes": {
    "invert_y": {
      "type": "boolean",
      "default": false,
      "label": "Invert y",
      "help": "Required for PNG background pixel coordinates with origin at top left."
    }
  },
  "labels": {
    "label_show": {
      "type": "boolean",
      "default": false,
      "label": "Label show",
      "help": ""
    },
    "label_size": {
      "type": "number",
      "default": 2.8,
      "label": "Label size",
      "help": "",
      "min": 1,
      "max": 6
    },
    "title": {
      "type": "string",
      "default": "",
      "label": "Title",
      "help": ""
    },
    "subtitle": {
      "type": "string",
      "default": "",
      "label": "Subtitle",
      "help": "Empty uses the automatic description."
    },
    "caption": {
      "type": "string",
      "default": "",
      "label": "Caption",
      "help": ""
    },
    "title_size": {
      "type": "number",
      "default": 13,
      "label": "Title size",
      "help": "Only when a nonempty title is supplied.",
      "min": 6,
      "max": 30
    }
  },
  "marks": {
    "fill_alpha": {
      "type": "number",
      "default": 0.85,
      "label": "Fill alpha",
      "help": "",
      "min": 0.05,
      "max": 1
    },
    "line_width": {
      "type": "number",
      "default": 0.6,
      "label": "Line width",
      "help": "",
      "min": 0.1,
      "max": 3
    },
    "map_mark": {
      "type": "select",
      "label": "Geometry",
      "default": "polygon",
      "options": [
        "polygon",
        "spot"
      ],
      "help": "Use ordered polygon vertices or independently supplied spot coordinates."
    },
    "point_size": {
      "type": "number",
      "label": "Spot size",
      "default": 2.5,
      "min": 0.2,
      "max": 12,
      "help": "Applies to spot geometry."
    }
  },
  "colors": {
    "low_color": {
      "type": "color",
      "default": "#EAF1F5",
      "label": "Low color",
      "help": ""
    },
    "high_color": {
      "type": "color",
      "default": "#315D86",
      "label": "High color",
      "help": ""
    },
    "border_color": {
      "type": "color",
      "default": "#FFFFFF",
      "label": "Border color",
      "help": ""
    }
  },
  "legend": {
    "legend_title": {
      "type": "string",
      "default": "",
      "label": "Legend title",
      "help": ""
    },
    "legend_show": {
      "type": "boolean",
      "default": true,
      "label": "Legend show",
      "help": ""
    },
    "legend_position": {
      "type": "select",
      "default": "right",
      "label": "Legend position",
      "help": "",
      "options": [
        "right",
        "bottom",
        "top",
        "left"
      ]
    },
    "legend_text_size": {
      "type": "number",
      "default": 9,
      "label": "Legend text size",
      "help": "",
      "min": 5,
      "max": 20
    }
  },
  "theme": {
    "font_family": {
      "type": "select",
      "default": "sans",
      "label": "Font family",
      "help": "",
      "options": [
        "sans",
        "serif",
        "mono"
      ]
    },
    "base_size": {
      "type": "number",
      "default": 11,
      "label": "Base size",
      "help": "",
      "min": 6,
      "max": 22
    },
    "plot_background": {
      "type": "color",
      "default": "#FFFFFF",
      "label": "Plot background",
      "help": ""
    }
  },
  "export": {
    "width": {
      "type": "number",
      "default": 8,
      "label": "Width",
      "help": "Inches.",
      "min": 3,
      "max": 20
    },
    "height": {
      "type": "number",
      "default": 6,
      "label": "Height",
      "help": "Inches.",
      "min": 3,
      "max": 20
    },
    "dpi": {
      "type": "integer",
      "default": 150,
      "label": "Dpi",
      "help": "",
      "min": 72,
      "max": 600
    }
  }
}
