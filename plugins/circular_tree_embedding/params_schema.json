{
  "data_mapping": {
    "x_column": {
      "type": "column",
      "default": "UMAP_1",
      "label": "Embedding X"
    },
    "y_column": {
      "type": "column",
      "default": "UMAP_2",
      "label": "Embedding Y"
    },
    "cluster_column": {
      "type": "column",
      "default": "subtype",
      "label": "Leaf / subtype"
    },
    "group_column": {
      "type": "column",
      "default": "subclass",
      "label": "Center color annotation"
    },
    "hierarchy_columns": {
      "type": "columns",
      "default": [
        "class",
        "subclass"
      ],
      "label": "Hierarchy from broad to fine",
      "help": "Ordered categorical columns. Each leaf must have exactly one path. Leaf column is added automatically."
    },
    "feature_columns": {
      "type": "columns",
      "default": [
        "Gene_A",
        "Gene_B",
        "Gene_C",
        "Gene_D"
      ],
      "label": "Similarity features",
      "help": "Numeric features for tree_mode = similarity. Uses per-leaf means, never embedding distances."
    }
  },
  "statistics": {
    "tree_mode": {
      "type": "select",
      "default": "annotation",
      "label": "Tree construction",
      "options": [
        "annotation",
        "similarity"
      ],
      "help": "Annotation uses ordered categorical paths; similarity clusters per-leaf feature means."
    },
    "cluster_method": {
      "type": "select",
      "default": "average",
      "label": "Linkage method",
      "options": [
        "average",
        "complete",
        "single",
        "ward.D2"
      ],
      "help": "Only for tree_mode = similarity; Euclidean distance on per-leaf feature means."
    },
    "scale_features": {
      "type": "boolean",
      "default": true,
      "label": "Standardize features",
      "help": "Only for tree_mode = similarity. Z-score each feature across leaf means; constant features contribute zero."
    }
  },
  "marks": {
    "point_size": {
      "type": "number",
      "default": 0.45,
      "label": "Point size",
      "min": 0.05,
      "max": 3,
      "help": ""
    },
    "point_alpha": {
      "type": "number",
      "default": 0.72,
      "label": "Point opacity",
      "min": 0.05,
      "max": 1,
      "help": ""
    },
    "hull_alpha": {
      "type": "number",
      "default": 0.13,
      "label": "Hull opacity",
      "min": 0,
      "max": 1,
      "help": "Hull opacity applies only when hull_show is enabled."
    },
    "tree_line_width": {
      "type": "number",
      "default": 0.32,
      "label": "Tree line width",
      "min": 0.1,
      "max": 2,
      "help": ""
    },
    "hull_show": {
      "type": "boolean",
      "default": true,
      "label": "Show group envelopes",
      "help": "Convex hulls are descriptive envelopes, not density contours or confidence intervals."
    }
  },
  "colors": {
    "palette": {
      "type": "select",
      "default": "Dark 3",
      "label": "Palette",
      "options": [
        "Dark 3",
        "Set 2",
        "Dynamic"
      ]
    },
    "group_colors": {
      "type": "object",
      "default": {},
      "label": "Annotation colors",
      "help": "Named colors keyed by column:value (for example class:Neuronal), or by category name. Shared by rings and embedding."
    },
    "tree_color": {
      "type": "color",
      "default": "#9CAFB0",
      "label": "Tree color"
    }
  },
  "labels": {
    "label_show": {
      "type": "boolean",
      "default": true,
      "label": "Show center labels"
    },
    "label_size": {
      "type": "number",
      "default": 2.6,
      "label": "Center label size",
      "min": 1,
      "max": 6,
      "help": "Only when label_show is enabled; in ggplot text units."
    },
    "leaf_label_show": {
      "type": "boolean",
      "default": true,
      "label": "Show outer leaf labels"
    },
    "leaf_label_size": {
      "type": "number",
      "default": 2.5,
      "label": "Outer label size",
      "min": 1,
      "max": 6,
      "help": "Only when leaf_label_show is enabled; auto-fit shrinks dense or long labels."
    },
    "ring_label_show": {
      "type": "boolean",
      "default": true,
      "label": "Show ring labels",
      "help": "Labels are omitted for arcs too narrow to hold their text."
    },
    "ring_label_size": {
      "type": "number",
      "default": 2.3,
      "label": "Ring label size",
      "min": 1,
      "max": 5,
      "help": "Only when ring_label_show is enabled; labels auto-fit to arc length."
    },
    "title": {
      "type": "string",
      "default": "",
      "label": "Title"
    },
    "subtitle": {
      "type": "string",
      "default": "",
      "label": "Subtitle"
    },
    "caption": {
      "type": "string",
      "default": "",
      "label": "Caption"
    }
  },
  "layout": {
    "embedding_radius": {
      "type": "number",
      "default": 0.62,
      "label": "Center embedding radius",
      "min": 0.25,
      "max": 0.72,
      "help": "Fraction of tree outer radius. Isotropic scaling preserves the supplied coordinate aspect ratio."
    },
    "gap_angle": {
      "type": "number",
      "default": 18,
      "label": "Circular opening (degrees)",
      "min": 3,
      "max": 90
    },
    "rotation": {
      "type": "number",
      "default": 0,
      "label": "Rotation (degrees)",
      "min": -180,
      "max": 180
    },
    "ring_width": {
      "type": "number",
      "default": 0.045,
      "label": "Annotation ring width",
      "min": 0.015,
      "max": 0.1
    }
  },
  "theme": {
    "font_family": {
      "type": "select",
      "default": "sans",
      "label": "Font family",
      "options": [
        "sans",
        "serif",
        "mono"
      ]
    },
    "base_size": {
      "type": "number",
      "default": 11,
      "label": "Base font size",
      "min": 6,
      "max": 20
    },
    "plot_background": {
      "type": "color",
      "default": "#FFFFFF",
      "label": "Background"
    }
  },
  "export": {
    "width": {
      "type": "number",
      "default": 10,
      "label": "Width",
      "min": 4,
      "max": 20
    },
    "height": {
      "type": "number",
      "default": 10,
      "label": "Height",
      "min": 4,
      "max": 20
    },
    "dpi": {
      "type": "integer",
      "default": 180,
      "label": "Dpi",
      "min": 72,
      "max": 600
    }
  }
}
