{
  "data_mapping": {
    "feature_column": {
      "type": "column",
      "default": "gene",
      "label": "Feature column",
      "help": ""
    },
    "sample_column": {
      "type": "column",
      "default": "sample",
      "label": "Sample column",
      "help": ""
    },
    "group_column": {
      "type": "column",
      "default": "alteration",
      "label": "Group column",
      "help": ""
    }
  },
  "layout": {
    "row_order": {
      "type": "select",
      "default": "frequency",
      "label": "Row order",
      "help": "",
      "options": [
        "frequency",
        "input"
      ]
    },
    "frequency_show": {
      "type": "boolean",
      "default": true,
      "label": "Frequency show",
      "help": ""
    }
  },
  "labels": {
    "sample_label_show": {
      "type": "boolean",
      "default": false,
      "label": "Sample label show",
      "help": ""
    },
    "title": {
      "type": "string",
      "default": "",
      "label": "Title",
      "help": ""
    },
    "subtitle": {
      "type": "string",
      "default": "",
      "label": "Subtitle",
      "help": "Empty uses the automatic description."
    },
    "caption": {
      "type": "string",
      "default": "",
      "label": "Caption",
      "help": ""
    },
    "title_size": {
      "type": "number",
      "default": 13,
      "label": "Title size",
      "help": "Only when a nonempty title is supplied.",
      "min": 6,
      "max": 30
    }
  },
  "colors": {
    "empty_color": {
      "type": "color",
      "default": "#EDF0F3",
      "label": "Empty color",
      "help": ""
    },
    "frequency_color": {
      "type": "color",
      "default": "#5D7286",
      "label": "Frequency color",
      "help": "Only when frequency_show is enabled."
    },
    "palette": {
      "type": "select",
      "default": "Set 2",
      "label": "Palette",
      "help": "",
      "options": [
        "Set 2",
        "Dark 3",
        "Viridis"
      ]
    },
    "group_colors": {
      "type": "object",
      "default": {},
      "label": "Named colors",
      "help": "Named categorical colors override the palette."
    }
  },
  "legend": {
    "legend_show": {
      "type": "boolean",
      "default": true,
      "label": "Legend show",
      "help": ""
    },
    "legend_position": {
      "type": "select",
      "default": "right",
      "label": "Legend position",
      "help": "",
      "options": [
        "right",
        "bottom",
        "top",
        "left"
      ]
    },
    "legend_text_size": {
      "type": "number",
      "default": 9,
      "label": "Legend text size",
      "help": "",
      "min": 5,
      "max": 20
    }
  },
  "theme": {
    "font_family": {
      "type": "select",
      "default": "sans",
      "label": "Font family",
      "help": "",
      "options": [
        "sans",
        "serif",
        "mono"
      ]
    },
    "base_size": {
      "type": "number",
      "default": 11,
      "label": "Base size",
      "help": "",
      "min": 6,
      "max": 22
    },
    "plot_background": {
      "type": "color",
      "default": "#FFFFFF",
      "label": "Plot background",
      "help": ""
    }
  },
  "export": {
    "width": {
      "type": "number",
      "default": 8,
      "label": "Width",
      "help": "Inches.",
      "min": 3,
      "max": 20
    },
    "height": {
      "type": "number",
      "default": 6,
      "label": "Height",
      "help": "Inches.",
      "min": 3,
      "max": 20
    },
    "dpi": {
      "type": "integer",
      "default": 150,
      "label": "Dpi",
      "help": "",
      "min": 72,
      "max": 600
    }
  }
}
