{
  "data_mapping": {
    "x_column": {
      "type": "column",
      "default": "method_a",
      "label": "X column",
      "help": ""
    },
    "y_column": {
      "type": "column",
      "default": "method_b",
      "label": "Y column",
      "help": ""
    },
    "group_column": {
      "type": "column",
      "default": "group",
      "label": "Group column",
      "help": ""
    }
  },
  "statistics": {
    "difference_mode": {
      "type": "select",
      "default": "absolute",
      "label": "Difference mode",
      "help": "",
      "options": [
        "absolute",
        "percent"
      ]
    },
    "loa_multiplier": {
      "type": "number",
      "default": 1.96,
      "label": "Loa multiplier",
      "help": "Bias \u00b1 multiplier \u00d7 sample SD; these are agreement limits, not bias confidence intervals.",
      "min": 0.5,
      "max": 4
    },
    "trend_show": {
      "type": "boolean",
      "default": false,
      "label": "Trend show",
      "help": ""
    }
  },
  "labels": {
    "label_show": {
      "type": "boolean",
      "default": true,
      "label": "Label show",
      "help": ""
    },
    "label_size": {
      "type": "number",
      "default": 2.8,
      "label": "Label size",
      "help": "",
      "min": 1,
      "max": 6
    },
    "title": {
      "type": "string",
      "default": "",
      "label": "Title",
      "help": ""
    },
    "subtitle": {
      "type": "string",
      "default": "",
      "label": "Subtitle",
      "help": "Empty uses the automatic description."
    },
    "caption": {
      "type": "string",
      "default": "",
      "label": "Caption",
      "help": ""
    },
    "title_size": {
      "type": "number",
      "default": 13,
      "label": "Title size",
      "help": "Only when a nonempty title is supplied.",
      "min": 6,
      "max": 30
    }
  },
  "marks": {
    "point_alpha": {
      "type": "number",
      "default": 0.75,
      "label": "Point alpha",
      "help": "",
      "min": 0.05,
      "max": 1
    },
    "point_size": {
      "type": "number",
      "default": 2,
      "label": "Point size",
      "help": "",
      "min": 0.1,
      "max": 10
    },
    "line_width": {
      "type": "number",
      "default": 0.6,
      "label": "Line width",
      "help": "",
      "min": 0.1,
      "max": 3
    }
  },
  "colors": {
    "palette": {
      "type": "select",
      "default": "Set 2",
      "label": "Palette",
      "help": "",
      "options": [
        "Set 2",
        "Dark 3",
        "Viridis"
      ]
    },
    "group_colors": {
      "type": "object",
      "default": {},
      "label": "Named colors",
      "help": "Named categorical colors override the palette."
    }
  },
  "legend": {
    "legend_show": {
      "type": "boolean",
      "default": true,
      "label": "Legend show",
      "help": ""
    },
    "legend_position": {
      "type": "select",
      "default": "right",
      "label": "Legend position",
      "help": "",
      "options": [
        "right",
        "bottom",
        "top",
        "left"
      ]
    },
    "legend_text_size": {
      "type": "number",
      "default": 9,
      "label": "Legend text size",
      "help": "",
      "min": 5,
      "max": 20
    }
  },
  "theme": {
    "font_family": {
      "type": "select",
      "default": "sans",
      "label": "Font family",
      "help": "",
      "options": [
        "sans",
        "serif",
        "mono"
      ]
    },
    "base_size": {
      "type": "number",
      "default": 11,
      "label": "Base size",
      "help": "",
      "min": 6,
      "max": 22
    },
    "plot_background": {
      "type": "color",
      "default": "#FFFFFF",
      "label": "Plot background",
      "help": ""
    },
    "grid_show": {
      "type": "boolean",
      "default": false,
      "label": "Grid show",
      "help": ""
    }
  },
  "export": {
    "width": {
      "type": "number",
      "default": 8,
      "label": "Width",
      "help": "Inches.",
      "min": 3,
      "max": 20
    },
    "height": {
      "type": "number",
      "default": 6,
      "label": "Height",
      "help": "Inches.",
      "min": 3,
      "max": 20
    },
    "dpi": {
      "type": "integer",
      "default": 150,
      "label": "Dpi",
      "help": "",
      "min": 72,
      "max": 600
    }
  }
}
