{
  "plugin": "interactive_genomic_signal_track_plot",
  "properties": {
    "track_column": {
      "type": "column",
      "default": "track"
    },
    "position_column": {
      "type": "column",
      "default": "position"
    },
    "value_column": {
      "type": "column",
      "default": "value"
    },
    "expression_track_column": {
      "type": "column",
      "default": "track"
    },
    "expression_value_column": {
      "type": "column",
      "default": "expression"
    },
    "track_order": {
      "type": "array"
    },
    "tracks_include": {
      "type": "array"
    },
    "tracks_exclude": {
      "type": "array"
    },
    "position_limits": {
      "type": "array"
    },
    "value_limits": {
      "type": "array"
    },
    "expression_limits": {
      "type": "array"
    },
    "signal_scale": {
      "type": "string",
      "enum": [
        "none",
        "row",
        "global"
      ]
    },
    "signal_transform": {
      "type": "string",
      "enum": [
        "none",
        "log1p",
        "sqrt"
      ]
    },
    "signal_geom": {
      "type": "string",
      "enum": [
        "area",
        "line",
        "step"
      ]
    },
    "track_colors": {
      "type": [
        "object",
        "array"
      ]
    },
    "expression_show": {
      "type": "boolean",
      "default": true
    },
    "expression_geom": {
      "type": "string",
      "enum": [
        "violin",
        "box",
        "density",
        "rug",
        "diamond"
      ]
    },
    "feature_show": {
      "type": "boolean",
      "default": false
    },
    "interactive": {
      "type": "boolean",
      "default": true
    },
    "width": {
      "type": "number",
      "default": 14
    },
    "height": {
      "type": "number",
      "default": 8
    },
    "dpi": {
      "type": "integer",
      "default": 300
    }
  },
  "groups": {
    "data": [
      "track_column",
      "position_column",
      "value_column",
      "expression_track_column",
      "expression_value_column",
      "track_order",
      "tracks_include",
      "tracks_exclude",
      "position_limits",
      "value_limits",
      "expression_limits",
      "signal_scale",
      "signal_transform",
      "na_action",
      "impute_value"
    ],
    "tracks": [
      "track_baseline_show",
      "track_baseline_color",
      "track_baseline_width",
      "track_fill",
      "track_alpha",
      "track_outline_width",
      "track_colors",
      "signal_geom",
      "normalize_per_track",
      "track_label_show",
      "track_label_size",
      "track_label_color"
    ],
    "expression": [
      "expression_show",
      "expression_geom",
      "expression_fill",
      "expression_alpha",
      "expression_outline",
      "expression_statistic",
      "expression_title",
      "expression_axis_label"
    ],
    "features": [
      "feature_show",
      "feature_label_show",
      "feature_label_size",
      "feature_label_angle",
      "feature_fill",
      "feature_height",
      "feature_y",
      "feature_border"
    ],
    "theme": [
      "xlab",
      "ylab",
      "title",
      "subtitle",
      "title_size",
      "title_color",
      "title_face",
      "x_tick_size",
      "grid_show",
      "grid_color",
      "grid_width",
      "plot_background",
      "font_family",
      "base_size",
      "width",
      "height",
      "dpi"
    ],
    "interaction": [
      "interactive",
      "zoom",
      "lasso_select",
      "reset_view"
    ]
  }
}
