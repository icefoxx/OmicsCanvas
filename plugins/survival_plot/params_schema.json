{
  "data_mapping": {
    "time_column": {
      "type": "column",
      "default": "time",
      "label": "Follow-up time",
      "help": ""
    },
    "event_column": {
      "type": "column",
      "default": "event",
      "label": "Event indicator",
      "help": "0 = right-censored; 1 = event."
    },
    "group_column": {
      "type": "column",
      "default": "group",
      "label": "Group column",
      "help": ""
    }
  },
  "statistics": {
    "curve_type": {
      "type": "select",
      "default": "survival",
      "label": "Curve type",
      "help": "",
      "options": [
        "survival",
        "event_probability"
      ]
    },
    "stat_method": {
      "type": "select",
      "default": "none",
      "label": "Stat method",
      "help": "",
      "options": [
        "none",
        "logrank"
      ]
    },
    "landmark_time": {
      "type": "number",
      "default": 0,
      "label": "Landmark time",
      "help": "Condition on remaining observed beyond this time; uses original time coordinates.",
      "min": 0,
      "max": 20
    },
    "confidence_level": {
      "type": "number",
      "default": 0.95,
      "label": "Confidence level",
      "help": "",
      "min": 0.5,
      "max": 0.999
    }
  },
  "marks": {
    "confidence_show": {
      "type": "boolean",
      "default": true,
      "label": "Confidence show",
      "help": ""
    },
    "confidence_alpha": {
      "type": "number",
      "default": 0.16,
      "label": "Confidence alpha",
      "help": "Only when confidence_show is enabled.",
      "min": 0.01,
      "max": 0.6
    },
    "censor_show": {
      "type": "boolean",
      "default": true,
      "label": "Censor show",
      "help": ""
    },
    "point_size": {
      "type": "number",
      "default": 2,
      "label": "Point size",
      "help": "",
      "min": 0.1,
      "max": 10
    },
    "line_width": {
      "type": "number",
      "default": 0.6,
      "label": "Line width",
      "help": "",
      "min": 0.1,
      "max": 3
    }
  },
  "layout": {
    "risk_table_show": {
      "type": "boolean",
      "default": true,
      "label": "Risk table show",
      "help": ""
    },
    "risk_time_count": {
      "type": "integer",
      "default": 6,
      "label": "Risk time count",
      "help": "Only when risk_table_show is enabled.",
      "min": 3,
      "max": 12
    }
  },
  "labels": {
    "risk_text_size": {
      "type": "number",
      "default": 3,
      "label": "Risk text size",
      "help": "Only when risk_table_show is enabled.",
      "min": 1,
      "max": 6
    },
    "title": {
      "type": "string",
      "default": "",
      "label": "Title",
      "help": ""
    },
    "subtitle": {
      "type": "string",
      "default": "",
      "label": "Subtitle",
      "help": "Empty uses the automatic description."
    },
    "caption": {
      "type": "string",
      "default": "",
      "label": "Caption",
      "help": ""
    },
    "title_size": {
      "type": "number",
      "default": 13,
      "label": "Title size",
      "help": "Only when a nonempty title is supplied.",
      "min": 6,
      "max": 30
    }
  },
  "colors": {
    "palette": {
      "type": "select",
      "default": "Set 2",
      "label": "Palette",
      "help": "",
      "options": [
        "Set 2",
        "Dark 3",
        "Viridis"
      ]
    },
    "group_colors": {
      "type": "object",
      "default": {},
      "label": "Named colors",
      "help": "Named categorical colors override the palette."
    }
  },
  "legend": {
    "legend_show": {
      "type": "boolean",
      "default": true,
      "label": "Legend show",
      "help": ""
    },
    "legend_position": {
      "type": "select",
      "default": "right",
      "label": "Legend position",
      "help": "",
      "options": [
        "right",
        "bottom",
        "top",
        "left"
      ]
    },
    "legend_text_size": {
      "type": "number",
      "default": 9,
      "label": "Legend text size",
      "help": "",
      "min": 5,
      "max": 20
    }
  },
  "theme": {
    "font_family": {
      "type": "select",
      "default": "sans",
      "label": "Font family",
      "help": "",
      "options": [
        "sans",
        "serif",
        "mono"
      ]
    },
    "base_size": {
      "type": "number",
      "default": 11,
      "label": "Base size",
      "help": "",
      "min": 6,
      "max": 22
    },
    "plot_background": {
      "type": "color",
      "default": "#FFFFFF",
      "label": "Plot background",
      "help": ""
    },
    "grid_show": {
      "type": "boolean",
      "default": false,
      "label": "Grid show",
      "help": ""
    }
  },
  "export": {
    "width": {
      "type": "number",
      "default": 8,
      "label": "Width",
      "help": "Inches.",
      "min": 3,
      "max": 20
    },
    "height": {
      "type": "number",
      "default": 6,
      "label": "Height",
      "help": "Inches.",
      "min": 3,
      "max": 20
    },
    "dpi": {
      "type": "integer",
      "default": 150,
      "label": "Dpi",
      "help": "",
      "min": 72,
      "max": 600
    }
  }
}
