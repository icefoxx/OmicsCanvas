    "sample_column": {"type": "column", "label": "Sample column", "default": "", "help": "Optional sample or batch label; empty uses one synthetic All sample for sample bars."},
    "sample_count_column": {"type": "column", "label": "Sample cell count column", "default": "", "help": "Cell count for each cell_type/sample pair; required when sample_column is supplied."},
    "bar_mode": {"type": "select", "label": "Bar mode", "default": "cell_number", "options": ["cell_number", "sample_number", "sample_percent"], "help": "Sample modes use mapped sample counts, or one All sample when no sample columns are supplied."},
    "cell_type_order": {"type": "string_array", "label": "Cell type order", "default": [], "help": "Optional left-to-right order; empty uses input order."},
    "marker_order": {"type": "string_array", "label": "Marker order", "default": [], "help": "Optional top-to-bottom order; empty uses input order."},
    "cell_types_include": {"type": "string_array", "label": "Cell types to include", "default": [], "help": "Optional subset for layout stress tests or focused panels."},
    "markers_include": {"type": "string_array", "label": "Markers to include", "default": [], "help": "Optional marker subset for focused panels."},
    "sample_order": {"type": "string_array", "label": "Sample order", "default": [], "help": "Optional stack order for sample bars."}
  },
