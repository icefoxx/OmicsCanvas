{
  "data_mapping": {
    "cell_type_column": {"type": "column", "label": "Cell type column", "default": "cell_type", "help": "Cell-type labels shown as columns."},
    "class_column": {"type": "column", "label": "Class column", "default": "class", "help": "Top-level class for hierarchy brackets and bar colors."},
