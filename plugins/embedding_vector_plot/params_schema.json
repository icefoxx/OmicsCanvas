{
  "data_mapping": {
    "x_column": {
      "type": "column",
      "default": "x",
      "label": "X column",
      "help": ""
    },
    "y_column": {
      "type": "column",
      "default": "y",
      "label": "Y column",
      "help": ""
    },
    "vx_column": {
      "type": "column",
      "default": "vx",
      "label": "Vx column",
      "help": ""
    },
    "vy_column": {
      "type": "column",
      "default": "vy",
      "label": "Vy column",
      "help": ""
    },
    "group_column": {
      "type": "column",
      "default": "group",
      "label": "Group column",
      "help": ""
    }
  },
  "marks": {
    "vector_scale": {
      "type": "number",
      "default": 0.8,
      "label": "Vector scale",
      "help": "",
      "min": 0,
      "max": 5
    },
    "arrow_stride": {
      "type": "integer",
      "default": 4,
      "label": "Arrow stride",
      "help": "",
      "min": 1,
      "max": 100
    },
    "arrow_alpha": {
      "type": "number",
      "default": 0.8,
      "label": "Arrow alpha",
      "help": "",
      "min": 0.05,
      "max": 1
    },
    "arrow_length": {
      "type": "number",
      "default": 0.06,
      "label": "Arrow length",
      "help": "",
      "min": 0.01,
      "max": 0.3
    },
    "point_alpha": {
      "type": "number",
      "default": 0.35,
      "label": "Point alpha",
      "help": "",
      "min": 0.05,
      "max": 1
    },
    "point_size": {
      "type": "number",
      "default": 2,
      "label": "Point size",
      "help": "",
      "min": 0.1,
      "max": 10
    },
    "line_width": {
      "type": "number",
      "default": 0.6,
      "label": "Line width",
      "help": "",
      "min": 0.1,
      "max": 3
    }
  },
  "colors": {
    "palette": {
      "type": "select",
      "default": "Set 2",
      "label": "Palette",
      "help": "",
      "options": [
        "Set 2",
        "Dark 3",
        "Viridis"
      ]
    },
    "group_colors": {
      "type": "object",
      "default": {},
      "label": "Named colors",
      "help": "Named categorical colors override the palette."
    }
  },
  "labels": {
    "title": {
      "type": "string",
      "default": "",
      "label": "Title",
      "help": ""
    },
    "subtitle": {
      "type": "string",
      "default": "",
      "label": "Subtitle",
      "help": "Empty uses the automatic description."
    },
    "caption": {
      "type": "string",
      "default": "",
      "label": "Caption",
      "help": ""
    },
    "title_size": {
      "type": "number",
      "default": 13,
      "label": "Title size",
      "help": "Only when a nonempty title is supplied.",
      "min": 6,
      "max": 30
    }
  },
  "legend": {
    "legend_show": {
      "type": "boolean",
      "default": true,
      "label": "Legend show",
      "help": ""
    },
    "legend_position": {
      "type": "select",
      "default": "right",
      "label": "Legend position",
      "help": "",
      "options": [
        "right",
        "bottom",
        "top",
        "left"
      ]
    },
    "legend_text_size": {
      "type": "number",
      "default": 9,
      "label": "Legend text size",
      "help": "",
      "min": 5,
      "max": 20
    }
  },
  "theme": {
    "font_family": {
      "type": "select",
      "default": "sans",
      "label": "Font family",
      "help": "",
      "options": [
        "sans",
        "serif",
        "mono"
      ]
    },
    "base_size": {
      "type": "number",
      "default": 11,
      "label": "Base size",
      "help": "",
      "min": 6,
      "max": 22
    },
    "plot_background": {
      "type": "color",
      "default": "#FFFFFF",
      "label": "Plot background",
      "help": ""
    },
    "grid_show": {
      "type": "boolean",
      "default": false,
      "label": "Grid show",
      "help": ""
    }
  },
  "export": {
    "width": {
      "type": "number",
      "default": 8,
      "label": "Width",
      "help": "Inches.",
      "min": 3,
      "max": 20
    },
    "height": {
      "type": "number",
      "default": 6,
      "label": "Height",
      "help": "Inches.",
      "min": 3,
      "max": 20
    },
    "dpi": {
      "type": "integer",
      "default": 150,
      "label": "Dpi",
      "help": "",
      "min": 72,
      "max": 600
    }
  }
}
