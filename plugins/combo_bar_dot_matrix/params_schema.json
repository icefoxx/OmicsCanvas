      "type": "select",
      "label": "Line type",
      "default": "solid",
      "options": ["solid", "dashed", "dotted", "dotdash", "longdash"]
    },
    "hline_label_x": { "type": "number", "label": "Label X position", "default": null },
    "hline_label_y": { "type": "number", "label": "Label Y position", "default": null },
