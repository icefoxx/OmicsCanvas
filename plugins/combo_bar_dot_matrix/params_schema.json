{
  "data": {
    "x_column": { "type": "column", "label": "X category column (bars)", "default": null },
    "y_column": { "type": "column", "label": "Bar value column", "default": "auprc" },
    "se_column": { "type": "column", "label": "SE column", "default": "se" },
    "ci_low_column": { "type": "column", "label": "CI low", "default": "ci_low" },
    "ci_high_column": { "type": "column", "label": "CI high", "default": "ci_high" },
    "group_column": { "type": "column", "label": "Group / color class", "default": "group" },
    "color_column": { "type": "column", "label": "Explicit color column", "default": "color" },
    "annotation_column": {
      "type": "column",
      "label": "Per-bar annotation text column",
      "default": "annotation"
    },
    "x_order": { "type": "string_array", "label": "X category order", "default": [] },
    "feature_column": { "type": "column", "label": "Matrix feature column", "default": null },
    "feature_order": { "type": "string_array", "label": "Feature order (top→bottom)", "default": [] },
    "matrix_mode": {
      "type": "select",
      "label": "Matrix table mode",
      "default": "auto",
      "options": ["auto", "wide", "long"]
    },
    "matrix_value_mode": {
      "type": "select",
      "label": "Dot encoding",
      "default": "binary",
      "options": ["binary", "continuous", "fraction"],
      "help": "binary: filled/empty; continuous: heatmap-colored dots"
    }
  },
  "bar": {
    "ylab": { "type": "string", "label": "Y axis label", "default": "AUPRC" },
    "ymin": { "type": "number", "label": "Y min", "default": 0 },
