      "type": "object",
      "label": "Multiple lines [{y,label,color,linewidth,linetype,label_x,label_y,label_size,label_color,...}]",
      "default": []
    }
  },
  "matrix": {
    "matrix_show": { "type": "boolean", "label": "Show bottom dot matrix", "default": true },
    "dot_size": { "type": "number", "label": "Dot size", "default": 3.2 },
    "dot_stroke": { "type": "number", "label": "Dot border width", "default": 0.55 },
