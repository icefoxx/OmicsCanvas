    "group_colors": { "type": "object", "label": "Group colors {name:#hex}", "default": {} },
    "errorbar_show": { "type": "boolean", "label": "Show error bars", "default": true },
    "errorbar_width": { "type": "number", "label": "Error bar cap width", "default": 0.22 },
    "errorbar_linewidth": { "type": "number", "label": "Error bar line width", "default": 0.45 },
    "errorbar_color": { "type": "color", "label": "Error bar color", "default": "#222222" },
    "bar_annotation_size": { "type": "number", "label": "Bar annotation size", "default": 2.8 },
    "bar_annotation_color": { "type": "color", "label": "Bar annotation color", "default": "#333333" }
  },
  "comparisons": {
    "pvalue_label_style": {
      "type": "select",
      "label": "P-value label style",
      "default": "scientific",
      "options": ["scientific", "plain"]
    },
    "bracket_tip_length": { "type": "number", "label": "Bracket tip length", "default": 0.015 },
    "bracket_linewidth": { "type": "number", "label": "Bracket line width", "default": 0.4 },
    "bracket_color": { "type": "color", "label": "Bracket color", "default": "#333333" },
    "bracket_text_size": { "type": "number", "label": "Bracket text size", "default": 2.8 },
    "bracket_text_color": { "type": "color", "label": "Bracket text color", "default": "#333333" },
