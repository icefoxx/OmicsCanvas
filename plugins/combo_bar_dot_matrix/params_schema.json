    "dot_off_color": { "type": "color", "label": "Binary OFF fill", "default": "#FFFFFF" },
    "dot_border_color": { "type": "color", "label": "Dot border", "default": "#111111" },
    "matrix_low_color": { "type": "color", "label": "Continuous low", "default": "#F7FBFF" },
    "matrix_mid_color": { "type": "color", "label": "Continuous mid", "default": "#6BAED6" },
    "matrix_high_color": { "type": "color", "label": "Continuous high", "default": "#08306B" },
    "matrix_legend_show": { "type": "boolean", "label": "Continuous legend", "default": false },
    "matrix_panel_border": { "type": "boolean", "label": "Matrix panel border", "default": true },
    "matrix_border_color": { "type": "color", "label": "Matrix border color", "default": "#333333" },
    "matrix_border_width": { "type": "number", "label": "Matrix border width", "default": 0.5 },
    "matrix_row_label_size": { "type": "number", "label": "Feature label size", "default": 9 },
    "matrix_show_x_text": {
      "type": "boolean",
      "label": "Show x labels under matrix",
      "default": false
    },
    "x_context_label": {
      "type": "string",
      "label": "X-axis context label under matrix",
      "default": ""
    },
    "bar_panel_height": { "type": "number", "label": "Bar panel relative height", "default": 3.2 },
    "matrix_panel_height": { "type": "number", "label": "Matrix panel relative height", "default": 1.6 }
  },
  "title": {
    "title_show": { "type": "boolean", "label": "Show title", "default": false },
    "title": { "type": "string", "label": "Title", "default": "" },
    "title_size": { "type": "number", "label": "Title size", "default": 13 }
  },
  "canvas": {
    "width": { "type": "number", "label": "Width (in)", "default": 7.2 },
    "height": { "type": "number", "label": "Height (in)", "default": 5.4 },
    "dpi": { "type": "number", "label": "PNG DPI", "default": 300 },
    "font_family": { "type": "string", "label": "Font family", "default": "sans" },
    "base_size": { "type": "number", "label": "Base font size", "default": 11 },
    "background_color": { "type": "color", "label": "Background", "default": "#FFFFFF" },
    "x_text_size": { "type": "number", "label": "X tick size", "default": 9 },
    "x_text_angle": { "type": "number", "label": "X tick angle", "default": 45 },
    "y_text_size": { "type": "number", "label": "Y tick size", "default": 10 }
